{
  "name": "@overair/capacitor",
  "version": "0.1.0",
  "description": "Over-the-air updates for Capacitor apps.",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources/",
    "ios/Tests/",
    "Package.swift",
    "OverairCapacitor.podspec",
    "README.md",
    "docs/"
  ],
  "capacitor": {
    "ios": { "src": "ios" },
    "android": { "src": "android" }
  },
  "scripts": {
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:ios": "cd ios && swift build",
    "verify:android": "cd android && ./gradlew clean build test"
  },
  "dependencies": {},
  "peerDependencies": {
    "@capacitor/core": ">=6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "rimraf": "^6.0.1",
    "rollup": "^4.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
